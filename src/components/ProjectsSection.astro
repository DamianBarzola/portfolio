---
import Chips from "./Chips.astro";
import GithubIcon from "../assets/github.svg";
import WebIcon from "../assets/web.svg";
import costosApp from "../assets/images/costos-app/costos-app.png";
import costosApp1 from "../assets/images/costos-app/costos-app-calculate.png";
import costosApp2 from "../assets/images/costos-app/costos-app-template.png";
import costosApp3 from "../assets/images/costos-app/costos-app-pricelist.png";
import cineApp from "../assets/images/cine-app.svg";
import fleteros from "../assets/images/fleteros.png";
import dbcss from "../assets/images/dbcss/dbcss.png";
import dbcss1 from "../assets/images/dbcss/dbcss-home.png";
import dbcss2 from "../assets/images/dbcss/dbcss-demo.png";

const { data } = Astro.props;

const imageMap = {
  costosApp: costosApp.src,
  costosApp1: costosApp1.src,
  costosApp2: costosApp2.src,
  costosApp3: costosApp3.src,
  cineApp: cineApp.src,
  fleteros: fleteros.src,
  dbcss: dbcss.src,
  dbcss1: dbcss1.src,
  dbcss2: dbcss2.src,
};
---

<section id="projects">
  <span class="section-title">{data?.menu.projects}</span>
  <div class="container">
    {
      data?.projects &&
        data?.projects.map((project) => (
          <div class="card">
            <div class="carrousel">
              {project.imageKey.map((data) => (
                <div class={"image " + data.type}>
                  <img src={imageMap[data.image]} alt="" />
                </div>
              ))}
              {/* <div class="fade-overlay" /> */}
            </div>
            <div class="info">
              <p class="title">{project.name}</p>
              <p>{project.description}</p>
              {project.technologies && <Chips data={project.technologies} />}
              <div class="buttons">
                {project.web && (
                  <a
                    class="button"
                    href={project.web}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <WebIcon style={{ height: "1.7rem" }} />
                    <span>{data?.buttons?.web}</span>
                  </a>
                )}
                {project.repo && (
                  <a
                    class="button"
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <GithubIcon style={{ height: "1.4rem", width: "1.4rem" }} />
                    <span>{data?.buttons?.code}</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))
    }
  </div>
</section>
<style>
  .carrousel {
    height: 250px;
    margin: 0.5rem 1rem;
    grid-column: span 3 / span 2;
    display: flex;
    position: relative;
    gap: 3rem;
    overflow-y: hidden;
    overflow-x: scroll;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    -ms-overflow-style: none; /* IE y Edge */
    scrollbar-width: none;
  }
  /* .fade-overlay {
    position: absolute;
    right: 0;
    top: 0;
    width: 50px;
    height: 100%;
    background: linear-gradient(
      to right,
      transparent,
      white
    ); /* Cambia 'white' por el color de fondo */
    pointer-events: none; /* para que no bloquee el scroll */
  } */
  .image {
    max-height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .image.logo img {
    max-width: 150px;
  }
  .image.mobile img {
    object-fit: contain;
    /* width: 100px; */
    height: 90%;
    border-radius: 0.2rem;
  }
  .image.browser img {
    object-fit: contain;
    /* width: 220px; */
    height: 90%;
  }
  .projects {
    display: flex;
    width: 100%;
  }
  .container {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 2rem;
    padding-bottom: 0.5rem;
  }
  .title {
    font-size: 1.5rem;
    margin: 0;
    padding: 0;
    margin-bottom: 0.5rem;
    font-weight: bold;
  }
  .card {
    background-color: var(--card);
    border-radius: 0.4rem;
    border: var(--line) 1px solid;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .info {
    /* grid-column: span 2 / span 2; */
    grid-column: span 3 / span 2;

    padding: 1rem;
  }
  .info p {
    color: var(--text-tertiary);
  }
  .info .title {
    color: var(--text-primary);
  }
  .buttons {
    margin-top: 1rem;
    margin-bottom: 0.4rem;
    display: flex;
    width: 100%;
    gap: 1rem;
  }
  .button {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--text-tertiary);
    border-radius: 0.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    opacity: 0.8;
    transition: all ease-in-out 0.3s;
    text-decoration: none;
    color: var(--text-primary);
    gap: 0.6rem;
    font-weight: 500;
  }
  .button:hover {
    opacity: 1;
    background-color: var(--text-secondary);
    color: var(--text-active);
  }
  .button svg {
    transition: all ease-in-out 0.3s;
    fill: var(--text-secondary);
  }
  .button:hover > svg {
    fill: var(--text-active);
  }

  p {
    margin: 0;
    padding: 0.5rem 0 0 0;
  }
  @media screen and (max-width: 768px) {
    .card {
      flex-direction: column;
      grid-template-columns: repeat(1, 1fr);
    }
    .image {
      width: 100%;
      padding: 0.5rem 0;
    }
    .image img {
      max-height: 10rem;
    }
    .info {
      width: inherit;
      padding: 0.5rem;
    }
  }
</style>
